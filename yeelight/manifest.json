{
  "name": "yeelight",
  "description": "通过本地 stdio MCP 打开或关闭灯具、房间或全屋灯光。",
  "entrypoint": "src/skill.py",
  "actions": {
    "set_power": {
      "parameters": {
        "power": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "enum": [
            "device",
            "room",
            "home"
          ]
        },
        "room": {
          "type": "string"
        },
        "device": {
          "type": "string"
        }
      },
      "resources": [
        "yeelight.home"
      ]
    }
  },
  "version": "0.1.0",
  "api_version": 1,
  "setup": "src/setup.py",
  "dependencies": []
}
